.container { padding: 32rpx; }
.card { background:#fff; border-radius:16rpx; padding:24rpx; box-shadow:0 4rpx 16rpx rgba(0,0,0,0.06); margin-bottom:24rpx; }
.title { font-size:32rpx; font-weight:600; margin-bottom:12rpx; }
.level-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:8rpx; }
.level-name { font-size:36rpx; font-weight:700; }
.score { color:#576b95; }
.desc { color:#666; font-size:26rpx; margin-bottom:8rpx; }
.next { color:#999; font-size:24rpx; }
.actions { display:flex; gap:16rpx; }
.actions button { flex:1; }
/* new */
.home-card { background:#fff; border-radius:16rpx; padding:24rpx; box-shadow:0 4rpx 16rpx rgba(0,0,0,0.06); margin-bottom:24rpx; }
.row { display:flex; justify-content:space-between; align-items:center; padding:12rpx 0; }
.label { color:#666; }
.value { font-weight:700; font-size:36rpx; }
.btn-row { display:flex; gap:16rpx; }
.btn-row button { flex:1; }
.primary { background:#2fb46e; color:#fff; }
