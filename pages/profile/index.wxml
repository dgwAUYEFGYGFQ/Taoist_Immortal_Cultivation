<view class="page">
  <view class="header">
    <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"/>
    <view class="nickname">{{nickname || '游客'}}</view>
    <view class="status {{status}}">{{ status === 'ACTIVE' ? '已激活' : '未激活' }}</view>
  </view>

  <view class="section">
    <view class="row" bindtap="goLogin">
      <text class="label">账号</text>
      <text class="value">{{ nickname || '登录/切换账号' }}</text>
    </view>

    <view class="row">
      <text class="label">微信</text>
      <text class="value">{{ wechatBound ? ('已绑定（' + (nickname || '微信') + '）') : '未绑定' }}</text>
    </view>

    <block wx:if="{{!phoneBound}}">
      <view class="row" bindtap="goBind">
        <text class="label">手机号</text>
        <text class="value">去绑定</text>
      </view>
    </block>
    <block wx:else>
      <view class="row disabled" hover-class="none">
        <text class="label">手机号</text>
        <text class="value">{{ '已绑定（' + (phone || '') + '）' }}</text>
      </view>
    </block>


    <view class="row">
      <text class="label">善恶点</text>
      <text class="value">{{ virtueBalance }}</text>
    </view>

    <view class="row">
      <text class="label">贡献点</text>
      <text class="value">{{ contribBalance }}</text>
    </view>


    <view class="row" bindtap="goExhibits">
      <text class="label">藏宝阁</text>
      <text class="value">进入</text>
    </view>

    <view class="row" bindtap="goLedger">
      <text class="label">积分流水</text>
      <text class="value">查看</text>
    </view>
    <view class="row" bindtap="goDeedSubmit">
      <text class="label">功德提交</text>
      <text class="value">去提交</text>
    </view>

    <view class="row" bindtap="goZiYun">
      <text class="label">紫云阁</text>
      <text class="value">进入</text>
    </view>



    <block wx:if="{{role=='ELDER' || isAdmin}}">
      <view class="row" bindtap="goElderReview">
        <text class="label">评审工作台</text>
        <text class="value">进入</text>
      </view>
    </block>

    <block wx:if="{{role=='ADMIN' || isAdmin}}">
      <view class="row" bindtap="goAdminInvites">
        <text class="label">邀请码管理</text>
        <text class="value">进入</text>
      </view>
      <view class="row" bindtap="goAdminExhibits">
        <text class="label">展品管理</text>
        <text class="value">进入</text>
      </view>

    </block>
  </view>
</view>

