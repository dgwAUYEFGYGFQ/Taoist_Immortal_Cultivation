.page{display:flex;flex-direction:column;min-height:100vh;background:#fafafa}
.tabs{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.tabs-scroll{white-space:nowrap}
.tab-list{display:flex;flex-direction:row;padding:8px 12px}
.tab-item{display:flex;flex-direction:column;align-items:center;justify-content:center;margin-right:12px;padding:8px 12px;border-radius:8px;background:#f3f4f6;color:#374151}
.tab-item.active{background:#3cc51f;color:#fff}
.tab-item.locked{opacity:.6}
.tab-item .name{font-size:14px;font-weight:600}
.tab-item .sub{font-size:12px;margin-top:2px}

.list{padding:12px}
.card{background:#fff;border-radius:10px;overflow:hidden;margin-bottom:12px;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.card.disabled{opacity:.6}
.cover{width:100%;height:170px;background:#eee}
.meta{padding:10px}
.title{font-size:16px;font-weight:600;color:#111}
.subline{margin-top:4px;color:#666;font-size:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.badge{background:#f3f4f6;padding:2px 6px;border-radius:6px}
.cost{margin-left:auto;color:#576b95}
.hint{margin-top:4px;color:#a855f7;font-size:12px}
.empty{color:#888;text-align:center;padding:40px 0}

