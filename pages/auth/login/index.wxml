<view class="wrap">
  <view class="tabs">
    <view class="tab {{tab==='login'?'active':''}}" data-tab="login" bindtap="switchTab">已有账号登录</view>
    <view class="tab {{tab==='register'?'active':''}}" data-tab="register" bindtap="switchTab">使用邀请码注册</view>
  </view>

  <block wx:if="{{tab==='login'}}">
    <view class="section">
      <view class="row">
        <text class="label">手机号</text>
        <input class="input" value="{{phone}}" placeholder="请输入手机号" data-key="phone" bindinput="onInput" />
      </view>
      <view class="row">
        <text class="label">密码</text>
        <input class="input" value="{{password}}" password placeholder="请输入密码" data-key="password" bindinput="onInput" />
      </view>
      <button type="primary" bindtap="doPasswordLogin" loading="{{submitting}}">手机号密码登录</button>
      <view style="height:12px"></view>
      <button bindtap="doWeChatLogin" loading="{{logging}}">微信一键登录</button>
    </view>
  </block>

  <block wx:elif="{{tab==='register'}}">
    <view class="section">
      <view class="row">
        <text class="label">手机号</text>
        <input class="input" value="{{regPhone}}" placeholder="请输入手机号" data-key="regPhone" bindinput="onInput" />
      </view>
      <view class="row">
        <text class="label">密码</text>
        <input class="input" value="{{regPassword}}" password placeholder="设置登录密码(6-64位)" data-key="regPassword" bindinput="onInput" />
      </view>
      <view class="row">
        <text class="label">邀请码</text>
        <input class="input" value="{{inviteCode}}" placeholder="请输入邀请码" data-key="inviteCode" bindinput="onInput" />
      </view>
      <button type="primary" bindtap="doRegister" loading="{{submitting}}">注册并登录</button>
    </view>
  </block>

  <view class="dev">
    <view class="row">
      <text class="label">OpenID</text>
      <input class="input" value="{{openid}}" placeholder="如: dev-admin 或 dev-user" bindinput="onInputOpenid" />
    </view>
    <button bindtap="doLogin" loading="{{logging}}">开发态：手动 OpenID 登录</button>
  </view>
</view>
