.page{padding:12px}
.toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.row{display:flex;align-items:center;margin-bottom:8px}
.label{width:56px;color:#666}
.picker{padding:6px 10px;border:1px solid #eee;border-radius:6px}
.btn{margin-left:8px}
.filters{background:#fff;padding:8px 12px;border-radius:8px;margin-bottom:12px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.batchbar{background:#fff;padding:8px 12px;border-radius:8px;margin-bottom:12px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.input.small{width:100px}
.badge{background:#f3f4f6;padding:2px 6px;border-radius:6px;margin-right:6px}
.cost{color:#576b95}


.list .item{display:flex;padding:8px;border-bottom:1px solid #f0f0f0}
.thumb{width:72px;height:72px;border-radius:6px;background:#f7f7f7;margin-right:8px}
.meta{flex:1}
.name{font-weight:600;margin-bottom:4px}
.lore{color:#666;font-size:12px}
.ops{margin-top:6px}
.ops button{margin-right:6px}

.form{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top-left-radius:12px;border-top-right-radius:12px;box-shadow:0 -6px 16px rgba(0,0,0,0.08);padding:12px}
.input{flex:1;border:1px solid #eee;border-radius:6px;padding:6px 10px}
.textarea{min-height:72px;border:1px solid #eee;border-radius:6px;padding:6px 10px}
.preview{width:100%;height:160px;border-radius:8px;background:#f5f5f5;margin:8px 0}
.empty{padding:24px;color:#888;text-align:center}

