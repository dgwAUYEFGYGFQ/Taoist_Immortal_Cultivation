.wrap{padding:16rpx}
.section{background:#fff;border-radius:12rpx;padding:16rpx;margin-bottom:20rpx}
.row{display:flex;align-items:center;justify-content:space-between;padding:8rpx 0}
.label{color:#666}
.input{flex:1;text-align:right}
.picker{color:#333}
.btn{margin-top:16rpx}
.list .item{background:#fff;border-radius:12rpx;padding:16rpx;margin-bottom:12rpx;display:flex;align-items:center;justify-content:space-between}
.code{font-weight:600}
.meta{color:#888;font-size:24rpx}
.status{margin-right:12rpx}
.expire{margin-right:12rpx}

