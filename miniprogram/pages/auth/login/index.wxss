.wrap{padding:16rpx}
.tabs{display:flex;justify-content:space-around;margin-bottom:24rpx}
.tab{padding:12rpx 20rpx;color:#888;font-size:28rpx;border-bottom:4rpx solid transparent}
.tab.active{color:#07c160;border-bottom-color:#07c160;font-weight:500}
.section{background:#fff;border-radius:12rpx;padding:16rpx}
.row{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.label{color:#666;min-width:120rpx}
.input{flex:1;text-align:right}
.rg{display:flex;gap:24rpx}
.rg-item{margin-right:24rpx}
button{margin-top:24rpx}

