.page { padding: 12px; }
.tabs { display:flex; margin-bottom: 12px; border: 1px solid #eee; border-radius: 8rpx; overflow: hidden; }
.tab { flex:1; text-align: center; padding: 10px 0; color:#666; background:#fafafa; }
.tab + .tab { border-left: 1px solid #eee; }
.tab.active { color:#2fb46e; font-weight: 600; background:#fff; }
.item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #f0f0f0; }
.left { flex: 1; }
.title { font-size: 16px; color: #222; }
.sub { font-size: 12px; color: #888; margin-top: 4px; }
.right { width: 80px; text-align: right; font-weight: 600; }
.right.inc { color: #1abc9c; }
.right.dec { color: #e74c3c; }
.empty, .loading, .more, .done { text-align: center; color: #999; padding: 16px 0; }
