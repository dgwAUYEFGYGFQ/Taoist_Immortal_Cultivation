.page{display:flex;flex-direction:column;min-height:100vh;background:#fafafa}
.cover{width:100%;height:220px;background:#eee}
.content{padding:12px}
.title{font-size:18px;font-weight:700;margin-bottom:6px}
.meta{display:flex;gap:8px;align-items:center;color:#666;font-size:12px;margin-bottom:8px}
.badge{background:#f3f4f6;padding:2px 6px;border-radius:6px}
.author{margin-left:auto;color:#576b95}
.lore{white-space:pre-wrap;line-height:1.6;color:#333}
.locked-tip{color:#a855f7;background:#faf5ff;border:1px solid #f3e8ff;padding:8px;border-radius:8px}
.empty{color:#888;text-align:center;padding:40px 0}

